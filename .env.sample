PAPER_WS=localhost:7506
PRICEROLE=all
# Comma-separated allow-list of price/candle worker FAMILIES to stream.
# Leave EMPTY/unset to stream every family (the safe default). If you set it,
# every family you omit is silently not streamed: no `trade@<symbol>@<family>`
# ticks and every candle subscription request for it dropped — consumers then
# fall back to REST polling instead of live prices. Add a family here whenever
# a new exchange is enabled for trading.
# Known families: binance (alias binanceus), bybit, okx, kucoin, bitget,
# hyperliquid, kraken, coinbase
PRICE_CONNECTOR_EXCHANGES=
COINBASE_API_KEY=
COINBASE_API_SECRET=
EXCHANGE_SERVICE_API_URL=http://localhost:7507
WATCHDOG_APP=http://localhost:7522
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=gainium
RABBIT_PASSWORD=